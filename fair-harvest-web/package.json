{
  "name": "fair-harvest-web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js web experience for Fair Harvest.",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 3000",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "node --test test/",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fair-harvest/sdk": "file:../fair-harvest-sdk",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
