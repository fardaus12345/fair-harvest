# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Pooled connection, used by the application at runtime. Serverless functions
# are short-lived and numerous, so queries go through the connection pooler.
# On Neon this is the host containing "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Direct connection, used only by `prisma migrate`. Schema changes need a
# session the pooler cannot provide, so DDL bypasses it. Same host without
# "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Signs and verifies auth JWTs. Generate a real random secret for anything
# beyond local development.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="2h"

# Farmer Card verification provider: "demo" checks the seeded
# GovFarmerCardRecord table; "official" calls GOV_API_BASE_URL instead.
# See lib/server/verification/.
VERIFICATION_PROVIDER="demo"
GOV_API_BASE_URL=""
GOV_API_KEY=""

# Same-origin API base for both the SDK client and lib/api.js. Point at the
# app's own address (the Next.js server also hosts /api/v1 itself).
#
# LEAVE THIS UNSET ON VERCEL. The homepage is statically generated and calls
# these endpoints during the build; pointing it at the deployment's own domain
# makes the build wait on a server that is not listening yet, which times the
# page out after 60s. Unset, server-side rendering falls back to preview values
# and the build succeeds.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Seeds demo users, a demo government Farmer Card registry, and sample
# products/orders when running `npx prisma db seed`.
SEED_DEMO_DATA="true"

# ---------------------------------------------------------------------------
# Product image storage
# ---------------------------------------------------------------------------
# "local" writes uploads to UPLOAD_DIR on disk and serves them back through
# GET /api/v1/uploads/<key>. This is the development default.
# "object" uses Vercel Blob (lib/server/storage/objectStorageProvider.js).
# A deployed serverless filesystem is read-only and discarded between
# invocations, so production must use "object".
STORAGE_PROVIDER="local"

# Where the local provider writes files. Relative paths resolve from the
# fair-harvest-web directory. Gitignored; safe to delete and recreate.
UPLOAD_DIR="./storage/uploads"

# Vercel Blob credentials, required when STORAGE_PROVIDER=object. Adding a Blob
# store to the Vercel project injects BLOB_READ_WRITE_TOKEN automatically; do
# not commit a real token.
BLOB_READ_WRITE_TOKEN=""

# Public base URL of the blob store, without a trailing slash, e.g.
# "https://<store-id>.public.blob.vercel-storage.com". Deleting a replaced
# image needs its URL rather than its key, so the base is configured here.
BLOB_PUBLIC_BASE_URL=""
