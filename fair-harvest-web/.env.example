# SQLite by default for zero-setup local/demo use.
# Swap provider to "postgresql" in prisma/schema.prisma and point this at a
# Postgres connection string for production.
DATABASE_URL="file:./dev.db"

# Signs and verifies auth JWTs. Generate a real random secret for anything
# beyond local development.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="2h"

# Farmer Card verification provider: "demo" checks the seeded
# GovFarmerCardRecord table; "official" calls GOV_API_BASE_URL instead.
# See lib/server/verification/.
VERIFICATION_PROVIDER="demo"
GOV_API_BASE_URL=""
GOV_API_KEY=""

# Same-origin API base for both the SDK client and lib/api.js. Point at the
# app's own address (the Next.js server also hosts /api/v1 itself).
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Seeds demo users, a demo government Farmer Card registry, and sample
# products/orders when running `npx prisma db seed`.
SEED_DEMO_DATA="true"

# ---------------------------------------------------------------------------
# Product image storage
# ---------------------------------------------------------------------------
# "local" writes uploads to UPLOAD_DIR on disk and serves them back through
# GET /api/v1/uploads/<key>. This is the development and demo default.
# "object" selects lib/server/storage/objectStorageProvider.js, which is where a
# real S3 / Cloudinary / Supabase Storage client would be implemented. No
# provider credentials ship with this repository.
STORAGE_PROVIDER="local"

# Where the local provider writes files. Relative paths resolve from the
# fair-harvest-web directory. Gitignored; safe to delete and recreate.
UPLOAD_DIR="./storage/uploads"

# When STORAGE_PROVIDER=object, the chosen provider needs its own credentials.
# Add them here and read them inside objectStorageProvider.js. Never commit real
# values. Example shape for an S3-compatible bucket:
# STORAGE_BUCKET=""
# STORAGE_REGION=""
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
# STORAGE_PUBLIC_BASE_URL=""
